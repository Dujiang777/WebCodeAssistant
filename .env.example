# =============================================================================
#  Web Code Assistant · 环境变量样板
# =============================================================================
#  用法二选一：
#    本机跑   —— 逐条 export，或写进 shell 的 profile
#    Compose  —— cp .env.example deploy/.env  然后 cd deploy && docker compose up --build
#
#  下面按「上线必改 / 按需 / 可选调参」分三档。带 ★ 的项**不改就是事故**。
#  .env 本身已在 .gitignore 里，但这个样板文件要跟着仓库走 —— 它是部署说明书的一部分。
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  ★ 上线必改（三项，缺一不可）
# ─────────────────────────────────────────────────────────────────────────────

# 数据库。MySQL 8.0.13+。
DB_URL=jdbc:mysql://127.0.0.1:3306/webcode?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=%2B08:00&forceConnectionTimeZoneToSession=true
DB_USER=root
DB_PASSWORD=★换成你自己的强密码

# 签名密钥。至少 32 字节随机串，泄露等于任何人都能伪造登录态。
# 生成：openssl rand -base64 48
JWT_SECRET=★换成你自己的至少32字符的随机串

# 模型。任何 OpenAI 兼容服务都行（DeepSeek / 通义 / Kimi / vLLM / Ollama / one-api …）。
# 不填也能启动，只是对话会提示「模型未配置」，文件浏览与编辑照常可用。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=★sk-你的Key
LLM_MODEL=deepseek-flash


# ─────────────────────────────────────────────────────────────────────────────
#  账号体系（登录注册 / 邮箱验证 / 找回密码 / 失败锁定）
# ─────────────────────────────────────────────────────────────────────────────

# 令牌生命周期。access 短、refresh 长：客户端靠 refresh 静默续期，
# 所以 access 短一点不伤体验，却能显著压缩「令牌泄露还能用多久」的窗口。
JWT_TTL=PT2H
JWT_REFRESH_TTL=PT720H

# 连续失败几次锁定、锁多久。没有这个阈值，密码就能被无限次撞。
AUTH_MAX_FAILED=5
AUTH_LOCK_DURATION=PT15M

# 邮箱验证 / 重置密码链接里令牌的有效期，以及「重发」的冷却时间。
AUTH_TOKEN_TTL=PT30M
AUTH_RESEND_COOLDOWN=PT60S

# true = 未验证邮箱不能调用模型（文件浏览编辑仍可用）。
# **默认 false**：否则存量老账号会在上线瞬间被全部锁死。
AUTH_REQUIRE_VERIFIED_EMAIL=false

# 用来拼接邮件里的验证 / 重置链接。上线改成真实域名，否则用户点开跳不到你的站。
FRONTEND_BASE_URL=http://localhost:5173

# 管理员引导名单（逗号分隔）。全新部署时用它造出第一个管理员：
# 名单里的用户名在**注册那一刻**自动获得 ADMIN 角色。
# ★ 上线后建好管理员就清空它 —— 留着的含义是「这几个用户名谁先注册谁就是管理员」。
ADMIN_USERNAMES=


# ─────────────────────────────────────────────────────────────────────────────
#  邮件通道
# ─────────────────────────────────────────────────────────────────────────────
#  mode=dev  不发真邮件：令牌照常落库（可查库）、写日志、并在接口里回显，
#            本地/自测用它，能在没有 SMTP 的情况下跑通整条验证链路。
#  mode=smtp 发真邮件，下面 host/username/password 全部必填。上线必须切到这里。
MAIL_MODE=dev
MAIL_FROM=no-reply@webcode.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# true 用于 465 端口（隐式 TLS）；587 一般用 false，走 STARTTLS。
MAIL_SSL=false


# ─────────────────────────────────────────────────────────────────────────────
#  AI 用量积分
# ─────────────────────────────────────────────────────────────────────────────
#  计价单位：**每 1000 token 多少积分**。输出比输入贵，因为输出更耗算力。
CREDIT_SIGNUP_BONUS=300
CREDIT_PER_1K_INPUT=1
CREDIT_PER_1K_OUTPUT=3
# 一轮对话最低扣多少分。防止「模型秒回一句话」刷出 0.0x 分的噪声账目。
CREDIT_MIN_PER_TURN=1
# 每轮预扣多少分。结束时按真实 token 结算，多退少补 —— 这是「三段落账」的第一段。
# 定得过低会让余额不足的用户透支跑完一轮；定得过高会误拦余额尚可的用户。
CREDIT_HOLD=30
# 低于这个余额就在 UI 上提示，但不拦。真正拦截由 enforce-balance 决定。
CREDIT_LOW_THRESHOLD=50
# true = 余额不足直接拒绝发消息（402 INSUFFICIENT_CREDITS）。
# 想要「先让人用起来」可以先设 false，但商业化上线应该是 true。
CREDIT_ENFORCE=true


# ─────────────────────────────────────────────────────────────────────────────
#  语义检索（可选）
# ─────────────────────────────────────────────────────────────────────────────
#  DeepSeek 官方**没有** /v1/embeddings 端点，所以 embedding 允许独立配一个服务。
#  最常见组合：对话接 DeepSeek + 语义检索接本地或别家。
#  三项全留空 = 复用上面的 LLM_BASE_URL / LLM_API_KEY；只填模型名也可用（同源不同模型）。
#  ★ 只填 base-url 而漏掉模型名，语义检索会静默不可用（status.available=false）。
LLM_EMBED_BASE_URL=
LLM_EMBED_API_KEY=
LLM_EMBED_MODEL=


# ─────────────────────────────────────────────────────────────────────────────
#  前端 / 跨域
# ─────────────────────────────────────────────────────────────────────────────
#  允许的前端来源，逗号分隔。上线改成真实域名，否则浏览器会拦掉所有请求。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ─────────────────────────────────────────────────────────────────────────────
#  工作区与文件
# ─────────────────────────────────────────────────────────────────────────────
WORKSPACE_ROOT=./data/workspaces
# 单工作区总量上限（字节）。默认 200 MB。
MAX_WORKSPACE_BYTES=209715200
# 单文件浏览上限。超过就只读 —— 否则一次保存等于把大文件截断覆盖。
MAX_READ_BYTES=524288
GREP_MAX_RESULTS=50
MAX_TREE_ENTRIES=20000
MAX_ARCHIVE_ENTRIES=20000
MAX_UPLOAD_SIZE=120MB
CLONE_TIMEOUT=PT180S
CLONE_DEPTH=1


# ─────────────────────────────────────────────────────────────────────────────
#  编译验证（补丁应用后自动跑一次项目自己的构建）
# ─────────────────────────────────────────────────────────────────────────────
COMPILE_ENABLED=true
COMPILE_MVN=mvn
COMPILE_GRADLE=gradle
# ★ 必须指向 JDK 17+。本机 JAVA_HOME 是 JDK 8 时一定要设，否则编译一定失败。
COMPILE_JAVA_HOME=
# 用于覆盖 Maven 全局镜像（内网 mirrorOf=external:* 在没有内网的环境里会让依赖全下不来）。
# 自测可用 tools/maven-self-test-settings.xml。**别带进生产镜像。**
COMPILE_MVN_SETTINGS=
COMPILE_OFFLINE=false
COMPILE_TIMEOUT=PT240S
COMPILE_MAX_OUTPUT=24000


# ─────────────────────────────────────────────────────────────────────────────
#  网页终端（功能 12）
# ─────────────────────────────────────────────────────────────────────────────
TERMINAL_ENABLED=true
TERMINAL_TIMEOUT=PT120S
TERMINAL_MAX_OUTPUT=65536


# ─────────────────────────────────────────────────────────────────────────────
#  模型行为与限流
# ─────────────────────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=PT120S
LLM_LOG_REQUESTS=true
# 每用户每秒请求数、每日 token 上限。Redis 不可用时退化为单实例计数。
LLM_REQUESTS_PER_SECOND=2
LLM_DAILY_TOKEN_LIMIT=500000
LLM_HISTORY_MESSAGES=12
# 一轮对话最多几次工具调用。超限后工具会返回「请立即给出最终回答」。
LLM_MAX_TOOL_STEPS=12


# ─────────────────────────────────────────────────────────────────────────────
#  基础设施
# ─────────────────────────────────────────────────────────────────────────────
# Redis 只承载限流与配额计数，连不上会自动退回进程内实现（启动打 WARN），不阻塞任何功能。
# 多副本部署时必须让它可用，否则限流变成各实例各算各的。
REDIS_URL=redis://localhost:6379

SERVER_PORT=8080
LOG_LEVEL=INFO

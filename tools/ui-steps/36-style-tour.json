[
  ["set", "viewport", "1512", "950"],

  { "note": "① 登录页 · 三主题" },
  ["open", "http://127.0.0.1:5173/#/login"],
  { "sleep": 2200 },
  { "note": "前戏：清存储 + 硬刷。少了 reload 时，上一个剧本造在 body 上的探测元素会跨剧本残留进截图（浏览器 daemon 长期存活）" },
  ["eval", "localStorage.clear(); location.replace('/#/login'); location.reload(); 'reset'"],
  { "sleep": 2200 },
  ["screenshot", "docs/self-test/v8/tour-01-login-brass.png"],
  ["eval", "document.documentElement.dataset.theme='emerald'; 'emerald'"],
  { "sleep": 700 },
  ["screenshot", "docs/self-test/v8/tour-02-login-emerald.png"],
  ["eval", "document.documentElement.dataset.theme='ivory'; 'ivory'"],
  { "sleep": 700 },
  ["screenshot", "docs/self-test/v8/tour-03-login-ivory.png"],
  ["eval", "document.documentElement.dataset.theme='brass'; 'brass'"],
  { "sleep": 500 },

  { "note": "② 登录" },
  ["eval", "var s=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set; var u=document.querySelector('#username'); s.call(u,'admin'); u.dispatchEvent(new Event('input',{bubbles:true})); var p=document.querySelector('#password'); s.call(p,'WcaAdmin!2026'); p.dispatchEvent(new Event('input',{bubbles:true})); 'filled'"],
  { "sleep": 300 },
  ["eval", "document.querySelector('.form-stack .btn-primary').click(), 'submitted'"],
  { "sleep": 3400 },
  ["screenshot", "docs/self-test/v8/tour-04-workspaces-brass.png"],

  { "note": "③ IDE · 三主题" },
  ["eval", "var row=document.querySelector('.workspace-row'); row && row.click(), 'opened:'+(row?'yes':'no')"],
  { "sleep": 5200 },
  ["screenshot", "docs/self-test/v8/tour-05-ide-brass.png"],
  ["eval", "document.documentElement.dataset.theme='emerald'; localStorage.setItem('wca.theme','emerald'); 'emerald'"],
  { "sleep": 800 },
  ["screenshot", "docs/self-test/v8/tour-06-ide-emerald.png"],
  ["eval", "document.documentElement.dataset.theme='ivory'; localStorage.setItem('wca.theme','ivory'); 'ivory'"],
  { "sleep": 900 },
  ["screenshot", "docs/self-test/v8/tour-07-ide-ivory.png"],
  ["eval", "document.documentElement.dataset.theme='brass'; localStorage.setItem('wca.theme','brass'); 'brass'"],
  { "sleep": 500 },
  ["eval", "'TOUR_DONE'"]
]

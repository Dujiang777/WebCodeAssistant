[
  ["set", "viewport", "1512", "950"],

  ["open", "http://127.0.0.1:5173/#/login"],
  { "sleep": 2500 },
  ["find", "text", "一键随机演示账号", "click"],
  { "sleep": 3500 },
  ["click", ".form-stack .btn-primary"],
  { "sleep": 9000 },

  ["click", "[title=\"src/main/java/com/demo/UserService.java\"]"],
  { "sleep": 2500 },

  { "note": "功能13：Agent 工位 —— 先看空态（面板必须说清「这里将会出现什么」）" },
  ["click", "[title*=\"Agent 工位\"]"],
  { "sleep": 2000 },
  ["eval", "'DESK_PANEL=' + (document.querySelector('.desk') ? 'yes' : 'no') + ' EMPTY_TITLE=' + ((document.querySelector('.desk-empty-title')||{innerText:'none'}).innerText) + ' EMPTY_HINT=' + ((document.querySelector('.desk-empty-hint')||{innerText:'none'}).innerText)"],
  ["screenshot", "docs/self-test/v4/40-desk-empty.png"],

  { "note": "发一条真实指令 —— Agent 会在 propose_patch 之前被工具闸门拦下" },
  ["eval", "var ta=document.querySelector('.composer-input'); var set=Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype,'value').set; set.call(ta,'把 UserService 的字段注入改成构造器注入，直接给我补丁'); ta.dispatchEvent(new Event('input',{bubbles:true})); 'filled'"],
  { "sleep": 400 },
  ["eval", "document.querySelector('.composer-actions .btn-primary') ? (document.querySelector('.composer-actions .btn-primary').click(), 'sent') : 'no-send'"],
  { "sleep": 6500 },

  { "note": "功能14：闸门卡片 —— 审意图而不是审 diff，参数可改" },
  ["eval", "'GATE_CARDS=' + document.querySelectorAll('.gate-card').length + ' TITLE=' + ((document.querySelector('.gate-title')||{innerText:'none'}).innerText) + ' TOOL=' + ((document.querySelector('.gate-tool')||{innerText:'none'}).innerText) + ' TIMER=' + ((document.querySelector('.gate-timer')||{innerText:'none'}).innerText)"],
  ["eval", "'INTENT=' + ((document.querySelector('.gate-intent')||{innerText:'none'}).innerText) + ' | REASON=' + ((document.querySelector('.gate-reason')||{innerText:'none'}).innerText) + ' | PARAMS=' + document.querySelectorAll('.gate-param').length + ' KEYPARAMS=' + document.querySelectorAll('.gate-param.key').length"],
  ["eval", "'POLICY_ACTIVE=' + ((document.querySelector('.gate-policy .mode-btn.active')||{innerText:'none'}).innerText)"],
  ["screenshot", "docs/self-test/v4/41-tool-gate.png"],

  { "note": "改一项参数再放行 —— 验证「改参数放行」这条链路真的通" },
  ["eval", "var i=document.querySelectorAll('.gate-param .gate-param-input')[1]; var set=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set; i ? (set.call(i, i.value + '（人工改过）'), i.dispatchEvent(new Event('input',{bubbles:true})), 'edited-summary') : 'no-summary-param'"],
  ["eval", "'HAS_DIFF_TEXTAREA=' + (document.querySelector('.gate-param-input[rows]') ? 'yes' : 'no') + ' TOTAL_PARAMS=' + document.querySelectorAll('.gate-param .gate-param-input').length"],
  { "sleep": 600 },
  ["eval", "'APPROVE_LABEL=' + ((document.querySelector('.gate-actions .btn-primary')||{innerText:'none'}).innerText) + ' CHANGED_MARKS=' + document.querySelectorAll('.gate-param-changed').length"],
  ["eval", "document.querySelector('.gate-actions .btn-primary') ? (document.querySelector('.gate-actions .btn-primary').click(), 'approved') : 'no-approve'"],
  { "sleep": 7000 },

  { "note": "功能13：回合跑起来之后，工位上应该有摊开的文件 / 草稿 / 时间线" },
  ["eval", "'DESK_PHASE=' + ((document.querySelector('.desk-phase-label')||{innerText:'none'}).innerText) + ' COUNT=' + ((document.querySelector('.desk-count')||{innerText:'none'}).innerText)"],
  ["eval", "'DESK_FILES=' + document.querySelectorAll('.desk-file').length + ' DESK_DRAFTS=' + document.querySelectorAll('.desk-draft').length + ' DESK_TIMELINE=' + document.querySelectorAll('.desk-timeline-row').length + ' DESK_CURSOR=' + ((document.querySelector('.desk-cursor-file')||{innerText:'none'}).innerText)"],
  ["eval", "'DESK_DRAFT_STAT=' + ((document.querySelector('.desk-draft-stat')||{innerText:'none'}).innerText)"],
  ["screenshot", "docs/self-test/v4/42-desk-live.png"],

  { "note": "功能16：特性开关强制包裹 —— 未确认时应用按钮必须是锁住的" },
  ["eval", "'FLAG_CARDS=' + document.querySelectorAll('.flag-card').length + ' REQUIRED=' + document.querySelectorAll('.flag-card-required').length + ' TITLE=' + ((document.querySelector('.flag-title')||{innerText:'none'}).innerText) + ' KEY=' + ((document.querySelector('.flag-key')||{innerText:'none'}).innerText)"],
  ["eval", "'RUNBOOKS=' + document.querySelectorAll('.flag-runbook').length + ' OPEN=' + ((document.querySelector('.flag-runbook.open .flag-runbook-body')||{innerText:'none'}).innerText.slice(0,48)) + ' | CLOSED=' + ((document.querySelector('.flag-runbook.closed .flag-runbook-body')||{innerText:'none'}).innerText.slice(0,48))"],
  ["eval", "'LEGACY_LINES=' + ((document.querySelector('.flag-legacy')||{innerText:''}).innerText.split('\\n').length) + ' FACTS=' + document.querySelectorAll('.flag-fact').length + ' ACK_ON=' + (document.querySelector('.flag-ack.on') ? 'yes' : 'no')"],
  ["eval", "'APPLY_DISABLED=' + ((document.querySelector('.patch-actions .btn-primary')||{disabled:'missing'}).disabled)"],
  { "note": "把「勾选行 + 应用按钮」滚进视口再拍 —— 否则截图拍不到「应用被锁」的真实状态" },
  ["eval", "var r=document.querySelector('.flag-ack')||document.querySelector('.flag-card'); r ? (r.scrollIntoView({block:'start'}), 'scrolled') : 'no-anchor'"],
  { "sleep": 800 },
  ["screenshot", "docs/self-test/v4/43-flag-locked.png"],

  { "note": "勾选「已确认开关关闭时的旧路径」→ 应用按钮解禁" },
  ["eval", "var c=document.querySelector('.flag-ack input'); c ? (c.click(), 'checked') : 'no-checkbox'"],
  { "sleep": 900 },
  ["eval", "'ACK_ON=' + (document.querySelector('.flag-ack.on') ? 'yes' : 'no') + ' APPLY_DISABLED=' + ((document.querySelector('.patch-actions .btn-primary')||{disabled:'missing'}).disabled)"],
  ["eval", "var a=document.querySelector('.flag-ack'); a ? (a.scrollIntoView({block:'center'}), 'scrolled') : 'no-ack'"],
  { "sleep": 800 },
  ["screenshot", "docs/self-test/v4/44-flag-acked.png"],

  { "note": "功能15：平行宇宙 —— 影子工作区里推演，左右对照，默认不合并" },
  ["click", "[title*=\"平行宇宙\"]"],
  { "sleep": 2500 },
  ["eval", "'MODAL=' + ((document.querySelector('.modal-title')||{innerText:'none'}).innerText) + ' FILE_PREFILLED=' + ((document.querySelector('.whatif-setup .snapshots-input')||{value:'none'}).value)"],
  ["eval", "var q=document.querySelector('.whatif-question'); var setT=Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype,'value').set; setT.call(q,'假如把 UserService 的字段注入换成构造器注入，会是什么样子？'); q.dispatchEvent(new Event('input',{bubbles:true})); 'filled'"],
  { "sleep": 500 },
  ["screenshot", "docs/self-test/v4/45-whatif-setup.png"],
  ["eval", "document.querySelector('.whatif-setup-actions .btn-primary') ? (document.querySelector('.whatif-setup-actions .btn-primary').click(), 'asked') : 'no-ask'"],
  { "sleep": 12000 },
  ["eval", "'WHATIF_COLS=' + document.querySelectorAll('.whatif-col').length + ' ADD_LINES=' + document.querySelectorAll('.whatif-line.add').length + ' DEL_LINES=' + document.querySelectorAll('.whatif-line.del').length + ' STATUS=' + ((document.querySelector('.whatif-chip')||{innerText:'none'}).innerText)"],
  ["eval", "'WHATIF_STAT=' + ((document.querySelector('.whatif-stat')||{innerText:'none'}).innerText) + ' ACTIONS=' + Array.from(document.querySelectorAll('.whatif-actions .btn')).map(function(e){return e.innerText.trim()}).join(' / ')"],
  ["screenshot", "docs/self-test/v4/46-whatif-compare.png"],
  ["eval", "var btns=[].slice.call(document.querySelectorAll('.modal-foot .btn')); btns.length ? (btns[btns.length-1].click(), 'closed') : 'no-modal'"],
  { "sleep": 1200 },

  { "note": "整体：四栏工作台 + 圆角温润风格" },
  ["screenshot", "docs/self-test/v4/47-overall-four-pane.png"],
  ["eval", "'SHELL_PANES=' + document.querySelectorAll('.workbench > .pane').length + ' SPLITTERS=' + document.querySelectorAll('.workbench > .splitter').length + ' WORKBENCH_DISPLAY=' + getComputedStyle(document.querySelector('.workbench')).display + ' RADIUS=' + getComputedStyle(document.querySelector('.gate-policy .mode-btn.active')||document.body).borderRadius"]
]

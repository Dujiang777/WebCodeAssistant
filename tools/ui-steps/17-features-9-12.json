  ["fill", ".semantic-searchbar input", "user register controller service"],
  ["eval", "document.querySelector('.semantic-searchbar .btn-primary') ? (document.querySelector('.semantic-searchbar .btn-primary').click(), 'searched') : 'no-btn'"],
  { "sleep": 6000 },
  ["eval", "'HITS=' + document.querySelectorAll('.semantic-hit').length + ' FIRST=' + ((document.querySelector('.semantic-hit-head')||{innerText:'none'}).innerText.slice(0,80))"],
  ["screenshot", "docs/self-test/v3/35-semantic.png"],

  { "note": "功能12：网页终端" },
  ["eval", "var btns=[].slice.call(document.querySelectorAll('.modal-foot .btn')); btns.length ? (btns[btns.length-1].click(), 'closed') : 'no-modal'"],
  { "sleep": 800 },
  ["click", "[title*=\"终端\"]"],

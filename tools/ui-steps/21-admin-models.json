  { "sleep": 2200 },
  ["eval", "'TABS=' + Array.from(document.querySelectorAll('.ad-tab')).map(function (t) { return t.innerText; }).join('/') + ' STAT_CARDS=' + document.querySelectorAll('.ad-stat-card').length + ' TREND=' + (document.querySelector('.ad-trend-svg') ? 'yes' : 'no') + ' LEGEND=' + document.querySelectorAll('.ad-legend-dot').length"],
  ["screenshot", "docs/self-test/v6-admin/11-dashboard.png"],

  { "note": "users tab" },
  ["eval", "Array.from(document.querySelectorAll('.ad-tab')).find(function (t) { return t.innerText === '用户'; }).click(), 'users'"],
  { "sleep": 1500 },
  ["eval", "'SEARCH=' + (document.querySelector('.ad-search input') ? 'yes' : 'no') + ' SELECTS=' + document.querySelectorAll('.ad-select').length + ' ROWS=' + document.querySelectorAll('.ad-table tbody tr').length + ' BADGES=' + document.querySelectorAll('.ad-badge').length"],
  ["screenshot", "docs/self-test/v6-admin/12-users.png"],

  { "note": "user drawer" },
  ["eval", "var btns=document.querySelectorAll('.ad-table .act .btn'); btns.length ? (btns[btns.length-1].click(), 'opened') : 'no-rows'"],
  { "sleep": 1600 },
  ["eval", "'DRAWER=' + (document.querySelector('.ad-drawer-panel') ? 'yes' : 'no') + ' SECTIONS=' + document.querySelectorAll('.ad-drawer-section').length + ' FOOT=' + (document.querySelector('.ad-drawer-foot .btn') ? 'yes' : 'no')"],
  ["screenshot", "docs/self-test/v6-admin/13-user-drawer.png"],

  { "note": "orders / audit tabs" },
  ["eval", "var c=document.querySelector('.ad-drawer-close .icon-btn'); c && c.click(), 'closed'"],
  { "sleep": 500 },
  ["eval", "Array.from(document.querySelectorAll('.ad-tab')).find(function (t) { return t.innerText === '订单'; }).click(), 'orders'"],
  { "sleep": 1300 },
  ["eval", "'ORDER_ROWS=' + document.querySelectorAll('.ad-table tbody tr').length + ' EMPTY=' + (document.querySelector('.cr-empty') ? document.querySelector('.cr-empty').innerText.slice(0, 12) : 'none')"],
  ["screenshot", "docs/self-test/v6-admin/14-orders.png"],
  ["eval", "Array.from(document.querySelectorAll('.ad-tab')).find(function (t) { return t.innerText === '审计'; }).click(), 'audit'"],
  { "sleep": 1300 },
  ["eval", "'AUDIT_ITEMS=' + document.querySelectorAll('.ad-audit-item').length + ' SELECT=' + (document.querySelector('.ad-select') ? 'yes' : 'no')"],
  ["screenshot", "docs/self-test/v6-admin/15-audit.png"],

  { "note": "models page" },
  ["eval", "Array.from(document.querySelectorAll('.btn')).find(function (b) { return b.innerText.indexOf('工作区') >= 0 || b.innerText.indexOf('返回编辑器') >= 0; }).click(), 'back'"],
  { "sleep": 1200 },
  ["eval", "Array.from(document.querySelectorAll('.btn')).find(function (b) { return b.innerText.indexOf('模型服务') >= 0; }).click(), 'to-models'"],
  { "sleep": 2000 },
  ["eval", "'HERO=' + (document.querySelector('.md-hero-name') ? document.querySelector('.md-hero-name').innerText.slice(0, 16) : 'none') + ' CARDS=' + document.querySelectorAll('.md-card').length + ' PROVIDERS=' + document.querySelectorAll('.md-provider').length + ' ADD=' + (document.querySelector('.md-add') ? 'yes' : 'no')"],
  ["screenshot", "docs/self-test/v6-admin/16-models.png"],


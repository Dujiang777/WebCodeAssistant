  ["eval", "document.querySelector('.pr-toggle') ? (document.querySelector('.pr-toggle').click(), 'PR_TOGGLE_CLICKED') : 'NO_PR_TOGGLE'"],
  { "sleep": 3000 },
  ["eval", "'PR_BODY=' + (document.querySelector('.pr-body') ? 'OPEN' : 'CLOSED') + ' PR_TITLE=' + ((document.querySelector('.pr-title')||{innerText:''}).innerText.slice(0,80)) + ' RISK_BAR=' + (document.querySelector('.risk-bar') ? 'YES' : 'NO')"],
  ["eval", "document.querySelector('.pr-preview') ? String(document.querySelector('.pr-preview').scrollIntoView({block:'center'})) : 'none'"],
  { "sleep": 600 },

  ["click", "[title*=\"Spring 组件地图\"]"],
  { "sleep": 2500 },
  ["eval", "'SPRINGMAP=' + (document.querySelector('.springmap-layout') ? 'YES' : document.querySelectorAll('[class*=springmap]').length) + ' BEANS=' + document.querySelectorAll('.springmap-bean, [class*=bean]').length + ' EDGES=' + document.querySelectorAll('[class*=edge]').length"],
  ["screenshot", "docs/self-test/v3/31-spring-map.png"],

  { "note": "功能7：测试运行" },
  ["eval", "document.querySelector('.modal-head .icon-btn') ? (document.querySelector('.modal-head .icon-btn').click(), 'closed') : 'no-modal'"],
  { "sleep": 800 },
  ["click", "[title*=\"运行测试套件\"]"],
  { "sleep": 40000 },
  ["eval", "'TESTS_STATUS=' + (document.querySelector('.tests-status')||{innerText:'NO'} ).innerText + ' FAILURES=' + document.querySelectorAll('.tests-failure').length"],
  ["screenshot", "docs/self-test/v3/32-tests.png"],

  { "note": "功能8：变更预演 PR（在补丁卡里）" },
  ["eval", "document.querySelector('.modal-head .icon-btn') ? (document.querySelector('.modal-head .icon-btn').click(), 'closed') : 'no-modal'"],

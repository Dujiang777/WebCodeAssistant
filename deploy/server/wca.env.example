# ---------------------------------------------------------------------------
# WCA 服务器环境变量（放到 /opt/wca/wca.env，权限 600）
#
#   cp wca.env.example /opt/wca/wca.env && chmod 600 /opt/wca/wca.env
#
# 这个文件是**上线唯一的密钥载体**：不进 git、不进镜像、不进日志。
# systemd 用 EnvironmentFile 读它（见 wca-backend.service）。
# 带 CHANGE_ME 的四项必须替换，否则服务能起来但功能是残的。
# ---------------------------------------------------------------------------

# ── 服务端口 ────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── 数据库（MySQL 8，原生安装在宿主机上）────────────────────────────────────
# +08:00 必须写成 %2B08:00，否则 JDBC 解析失败
DB_URL=jdbc:mysql://127.0.0.1:3306/webcode?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=%2B08:00&forceConnectionTimeZoneToSession=true
DB_USER=webcode
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Redis（限流与配额计数；挂了会自动退回进程内实现）──────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── 工作区根目录（用户项目的落盘位置，也是备份对象）────────────────────────
WORKSPACE_ROOT=/opt/wca/workspaces

# ── 大模型：DeepSeek（对话）────────────────────────────────────────────────
# 不要把 Key 提交到任何仓库；官方没有 /v1/embeddings，语义检索见下方
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=CHANGE_ME_LLM_KEY
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# ── 向量检索 ───────────────────────────────────────────────────────────────
# DeepSeek 不提供 embeddings 端点。留空 = 语义检索降级（关键词检索仍可用）。
# 想让语义检索真正可用，就填一个提供 /v1/embeddings 的服务（如硅基流动）。
LLM_EMBED_BASE_URL=
LLM_EMBED_API_KEY=
LLM_EMBED_MODEL=

# ── 令牌与账号 ─────────────────────────────────────────────────────────────
# JWT_SECRET 至少 32 字节：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET
# 加密「用户自带模型 Key」（BYOK）用的密钥。不配会回退到 JWT_SECRET 并打 WARN ——
# 能跑，但两件事该用两把钥匙：泄露一把不至于连坐。
# 生成：openssl rand -base64 48
APP_SECRET=CHANGE_ME_APP_SECRET
JWT_TTL=PT2H
JWT_REFRESH_TTL=PT720H

AUTH_MAX_FAILED=5
AUTH_LOCK_DURATION=PT15M
AUTH_TOKEN_TTL=PT30M
AUTH_RESEND_COOLDOWN=PT60S
AUTH_REQUIRE_VERIFIED_EMAIL=false

# 邮件里的验证/重置链接指向哪里 —— 不改的话用户收到 localhost 的链接。
# ★ 端口必须写全：这台机器 80 被 Caddy 占着，WCA 走 8081。
#   少了 :8081，用户收到的邮件链接会落到别人的站点上。
FRONTEND_BASE_URL=http://139.199.88.15:8081
CORS_ALLOWED_ORIGINS=http://139.199.88.15:8081

# 首位管理员引导名单：填一次、注册完就清空（否则这个名字一直是管理员）
ADMIN_USERNAMES=

# ── 邮件：QQ SMTP（真实发信）──────────────────────────────────────────────
# MAIL_MODE=dev 只在本地自检用；线上必须 smtp
MAIL_MODE=smtp
MAIL_FROM=1452667526@qq.com
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_USERNAME=1452667526@qq.com
MAIL_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE

# ── 积分计费 ───────────────────────────────────────────────────────────────
CREDIT_SIGNUP_BONUS=300
CREDIT_PER_1K_INPUT=1
CREDIT_PER_1K_OUTPUT=3
CREDIT_MIN_PER_TURN=1
CREDIT_HOLD=30
CREDIT_LOW_THRESHOLD=50
CREDIT_ENFORCE=true

# ── 编译闭环：把 mvn 指到国内镜像 ──────────────────────────────────────────
COMPILE_MVN_SETTINGS=/opt/wca/maven-settings.xml

LOG_LEVEL=INFO
